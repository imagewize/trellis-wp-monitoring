---
# ansible-lint requires these specific values and warns if they differ,
# which also disables its --fix mode. See
# https://docs.ansible.com/projects/lint/rules/yaml/
extends: default
rules:
  line-length:
    max: 160
  truthy:
    allowed-values: ["true", "false"]
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
